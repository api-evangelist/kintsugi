        },
        {
          "name": "List product categories.",
          "request": { "method": "GET", "header": [ { "key": "x-organization-id", "value": "{{organizationId}}" } ], "url": { "raw": "{{baseUrl}}/products/categories", "host": ["{{baseUrl}}"], "path": ["products", "categories"] } }
        }
      ]
    },
    {
      "name": "Address Validation",
      "item": [
        {
          "name": "Validate and search an address.",
          "request": { "method": "GET", "header": [ { "key": "x-organization-id", "value": "{{organizationId}}" } ], "url": { "raw": "{{baseUrl}}/addresses/search", "host": ["{{baseUrl}}"], "path": ["addresses", "search"] } }
        },
