        },
        {
          "name": "Get attachments for an exemption.",
          "request": { "method": "GET", "header": [ { "key": "x-organization-id", "value": "{{organizationId}}" } ], "url": { "raw": "{{baseUrl}}/exemptions/:id/attachments", "host": ["{{baseUrl}}"], "path": ["exemptions", ":id", "attachments"] } }
