          "name": "Get nexus status for the organization.",
          "request": { "method": "GET", "header": [ { "key": "x-organization-id", "value": "{{organizationId}}" } ], "url": { "raw": "{{baseUrl}}/nexus", "host": ["{{baseUrl}}"], "path": ["nexus"] } }
        },
