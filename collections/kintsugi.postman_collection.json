          "request": { "method": "GET", "header": [ { "key": "x-organization-id", "value": "{{organizationId}}" } ], "url": { "raw": "{{baseUrl}}/addresses/suggestions", "host": ["{{baseUrl}}"], "path": ["addresses", "suggestions"] } }
        }
      ]
    },
