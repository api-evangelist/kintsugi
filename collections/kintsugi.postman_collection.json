        },
        {
          "name": "Delete a physical nexus.",
          "request": { "method": "DELETE", "header": [ { "key": "x-organization-id", "value": "{{organizationId}}" } ], "url": { "raw": "{{baseUrl}}/nexus/physical/:id", "host": ["{{baseUrl}}"], "path": ["nexus", "physical", ":id"] } }
        }
      ]
    },
    {
