          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "x-organization-id", "value": "{{organizationId}}" } ], "url": { "raw": "{{baseUrl}}/exemptions", "host": ["{{baseUrl}}"], "path": ["exemptions"] }, "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } } }
