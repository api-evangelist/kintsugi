        {
          "info": {
            "name": "Update a credit note for a transaction.",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.trykintsugi.com/v1/transactions/:id/credit-notes",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
