      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Products",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List products.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.trykintsugi.com/v1/products",
            "params": [
              {
                "name": "page",
                "value": "",
